# Banco e segredo do Payload
DATABASE_URI=postgres://hs:hs@127.0.0.1:5432/hs_cms
PAYLOAD_SECRET=troque-por-um-texto-longo-e-aleatorio

# Endereços públicos (sem barra no fim)
CMS_URL=http://localhost:3001
SITE_URL=http://localhost:3000

# Segredos compartilhados com o site (os mesmos valores nos dois serviços)
REVALIDATE_SECRET=
PREVIEW_SECRET=
QUOTE_PROXY_SECRET=

# Primeiro usuário administrador (só é usado enquanto não existe nenhum usuário)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Mídia em bucket compatível com S3 (R2, Railway). Sem S3_BUCKET, os arquivos ficam na pasta media/
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Avisos de cotação: e-mail (precisa do SMTP) e webhook opcional (n8n, WhatsApp)
QUOTE_NOTIFY_TO=
QUOTE_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
